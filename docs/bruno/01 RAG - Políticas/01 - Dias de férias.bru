meta {
  name: "01 - Dias de férias"
  type: http
  seq: 1
}

post {
  url: http://localhost:8000/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "question": "Quantos dias de férias tenho direito por ano?",
    "employee_id": "E123",
    "session_id": "demo-01"
  }
}

assert {
  cond: res.status == 200
  cond: res.body.answer != null
}
