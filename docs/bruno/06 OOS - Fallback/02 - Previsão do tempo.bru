meta {
  name: "02 - Previsão do tempo (fallback)"
  type: http
  seq: 2
}

post {
  url: http://localhost:8000/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "question": "Vai chover hoje?",
    "employee_id": "E123",
    "session_id": "demo-21"
  }
}

assert {
  cond: res.status == 200
  cond: res.body.answer != null
  cond: res.body.answer.toLowerCase().includes('não tenho')
}
