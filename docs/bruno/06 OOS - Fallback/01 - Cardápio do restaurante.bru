meta {
  name: "01 - Fora do escopo (fallback)"
  type: http
  seq: 1
}

post {
  url: http://localhost:8000/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "question": "Qual o cardápio do restaurante da empresa hoje?",
    "employee_id": "E123",
    "session_id": "demo-20"
  }
}

assert {
  cond: res.status == 200
  cond: res.body.answer != null
  cond: res.body.answer.toLowerCase().includes('não tenho')
}
