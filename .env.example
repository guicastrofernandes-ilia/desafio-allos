# LLM (obrigatório) — chave do provedor de LLM (interface OpenAI-compatible)
LLM_API_KEY=

# Base URL do provedor (ex.: https://api.provedor.example/v1). Vazio = default do SDK.
LLM_BASE_URL=

# Modelos do provedor (preencher com os IDs que seu provedor aceitar)
MODEL_PLANNER=
MODEL_SYNTHESIZER=
MODEL_JUDGE=
MODEL_EMBEDDINGS=

# URLs internas
CHROMA_DIR=.chroma
CHECKPOINT_DB=.checkpoints.sqlite

# Comportamento
GUARD_OUTPUT_THRESHOLD=0.7
LLM_MAX_RETRIES=3

# LangSmith (opcional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=desafio-agente-rh
